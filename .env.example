# Sao chép file này thành .env rồi điền key. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=gemini
# Tùy chọn override model cho mọi provider; để trống để dùng model bên dưới.
LLM_MODEL=
GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_MODEL=gpt-5.6-luna

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: hash (ổn định/offline) | gemini | sentence_transformers | openai
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=local-hash
EMBEDDING_DIM=768
EMBEDDING_FALLBACK_PROVIDER=hash

# Optional services
PAGEINDEX_API_KEY=
PAGEINDEX_BASE_URL=https://api.pageindex.ai
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=0.30
